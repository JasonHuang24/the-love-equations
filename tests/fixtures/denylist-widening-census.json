    "suffixes": ["ization", "ational", "fulness", "iveness", "ously", "ments", "ment", "ness", "able", "ible", "ally", "edly", "ingly", "ies", "ing", "ers", "er", "ed", "es", "s", ""],
    "variants": ["the base as written", "the base with a final y replaced by i"],
    "keep": "candidates whose stem equals the entry's stem, excluding the entry itself and `entry + s` (both already reached by the literal tests)"
  },
